# URL publique et clé anon/publishable : Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé serveur uniquement : Supabase > Project Settings > API > service_role/secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Clé serveur fal.ai : tableau de bord fal > API Keys (laisser vide en simulation).
FAL_KEY=
# Chiffrement des clés Fal enregistrées dans l’administration : générer 32 octets aléatoires encodés en Base64.
FAL_CREDENTIALS_ENCRYPTION_KEY=
# Identifiant de modèle OpenRouter disponible sur fal, transmis comme model à openrouter/router (ex. anthropic/claude-opus-5.5).
LLM_MODEL=
# Facultatif (28/10) : modèle des juges visuels seulement (vide = LLM_MODEL). Jamais un modèle Google (les images clés viennent de Gemini).
VISION_MODEL=
# Réservation USD maximale par requête LLM, à fixer selon le modèle et sa tarification fal/OpenRouter.
LLM_MAX_COST_USD=
# Facultatif : plafond de coût fournisseur nominal par vidéo, en USD (ex. 15 pour la règle d’architecture « 15 $ pour 30 s »). Vide = aucun blocage, conformément à AGENTS.md ; le plafond global reste réglé dans fal.ai.
VIDEO_COST_CAP_USD=
# Facultatif : estimation à laquelle s’applique ce plafond. « nominal » (défaut, vide = nominal) : une tentative de chaque étape. « worst_case » : toutes les relances automatiques comprises (≈ 2 fois le nominal). Décision d’équipe.
VIDEO_COST_CAP_MODE=
# Facultatif (test A/B) : true pour générer une image de fin sur les plans roulants (≈ 0,13 $ par plan roulant, indicatif). Vide ou false = désactivé.
KEYFRAME_END_FRAME_ROLLING=
# mock en simulation; live uniquement après activation et vérification de la chaîne.
PROVIDERS_MODE=mock
# Secrets aléatoires générés par l’administrateur, distincts des clés fournisseurs.
FAL_WEBHOOK_SECRET=
CRON_SECRET=
# Signature des storyboards préparés par le réalisateur (serveur uniquement, jamais NEXT_PUBLIC_) : 64 caractères aléatoires tirés d’un générateur de mots de passe, à coller dans Vercel. Obligatoire en mode live ; la changer invalide seulement les storyboards préparés et pas encore lancés.
STORYBOARD_SIGNING_KEY=
USD_TO_EUR_RATE=0.92
EUR_TO_FCFA=655.957
# URL publique de production; sinon fallback Vercel puis localhost.
APP_URL=
