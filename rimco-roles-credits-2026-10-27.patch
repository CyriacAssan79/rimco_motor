+import { describe, expect, it } from 'vitest';
+import { assignableRoles, canValidate, hasAdminRights, isOperator, normalizeProfileRole, roleLabel, roleSatisfies } from './roles';
+import { withoutInternalFields } from './internal-fields';
+import { generateTemporaryPassword } from './temporary-password';
+
+describe('rôles du 27/10 : collaborateur, admin (client), operateur (KÔMIAN)', () => {
+  it('donne à l’opérateur tous les droits d’admin, et les droits internes à lui seul', () => {
+    expect(hasAdminRights({ role: 'operateur' })).toBe(true);
+    expect(hasAdminRights({ role: 'admin' })).toBe(true);
+    expect(hasAdminRights({ role: 'collaborateur', canValidate: true })).toBe(false);
+    expect(isOperator({ role: 'operateur' })).toBe(true);
+    expect(isOperator({ role: 'admin' })).toBe(false);
+    expect(roleSatisfies('operateur', ['admin'])).toBe(true);
+    expect(roleSatisfies('admin', ['operateur'])).toBe(false);
+    expect(roleSatisfies('collaborateur', ['collaborateur', 'admin'])).toBe(true);
+  });
+
+  it('fait de « valider » un droit : collaborateur coché, admin et opérateur toujours', () => {
+    expect(canValidate({ role: 'collaborateur', canValidate: true })).toBe(true);
+    expect(canValidate({ role: 'collaborateur', canValidate: false })).toBe(false);
+    expect(canValidate({ role: 'admin' })).toBe(true);
+    expect(canValidate({ role: 'operateur' })).toBe(true);
+    expect(canValidate(null)).toBe(false);
+  });
+
+  it('lit un ancien profil « valideur » comme un collaborateur qui peut valider (avant la migration 0041)', () => {
+    expect(normalizeProfileRole('valideur', null)).toEqual({ role: 'collaborateur', canValidate: true });
+    expect(normalizeProfileRole('admin', false)).toEqual({ role: 'admin', canValidate: false });
+    expect(normalizeProfileRole('inconnu', true)).toEqual({ role: 'collaborateur', canValidate: true });
+  });
+
+  it('ne laisse attribuer le rôle opérateur que par un opérateur', () => {
+    expect(assignableRoles({ role: 'admin' })).toEqual(['collaborateur', 'admin']);
+    expect(assignableRoles({ role: 'operateur' })).toContain('operateur');
+  });
+
+  it('affiche le rôle en clair', () => {
+    expect(roleLabel({ role: 'operateur' })).toBe('Opérateur KÔMIAN');
+    expect(roleLabel({ role: 'collaborateur', canValidate: true })).toBe('Collaborateur · valideur');
+  });
+});
+
+describe('champs internes KÔMIAN', () => {
+  const payload = { id: 'v1', estimatedPriceFcfa: 9200, prompt: 'locked layer', storyboardCostUsd: 0.02, storyboardCostFcfa: 16, costPlanUsd: { nominal: 3 } };
+  it('retire coûts en dollars et prompts pour tout autre rôle que l’opérateur', () => {
+    expect(withoutInternalFields({ role: 'admin' }, payload)).toEqual({ id: 'v1', estimatedPriceFcfa: 9200 });
+    expect(withoutInternalFields({ role: 'collaborateur' }, payload)).toEqual({ id: 'v1', estimatedPriceFcfa: 9200 });
+    expect(withoutInternalFields({ role: 'operateur' }, payload)).toEqual(payload);
+  });
+});
+
+describe('mot de passe provisoire généré par le serveur', () => {
+  it('compte 16 caractères, sans caractère ambigu, et change à chaque appel', () => {
+    const first = generateTemporaryPassword();
+    expect(first).toHaveLength(16);
+    expect(first).not.toMatch(/[0O1lI]/);
+    expect(first).toMatch(/[!@#$%*?]/);
+    expect(generateTemporaryPassword()).not.toBe(first);
+    expect(() => generateTemporaryPassword(8)).toThrow();
+  });
+});
diff --git a/src/core/auth/roles.ts b/src/core/auth/roles.ts
new file mode 100644
index 0000000..023e1b3
--- /dev/null
+++ b/src/core/auth/roles.ts
@@ -0,0 +1,54 @@
+/**
+ * Roles (27/10/2026, docs/specs/ROLES-CREDITS-2026-10-27.md):
+ * - collaborateur : creates videos; may also hold the right to validate (profiles.can_validate);
+ * - admin         : administrator of the client (RIMCO) — team, media library, credits history; never production costs;
+ * - operateur     : KÔMIAN, a role of its own — everything an admin does, plus prices, credits, provider costs,
+ *                   models, fal key, comparison and storage.
+ * Pure functions: no Next.js, no Supabase, so they are unit-tested and shared by routes, pages and components.
+ */
+export const ROLES = ['collaborateur', 'admin', 'operateur'] as const;
+export type Role = (typeof ROLES)[number];
+
+export type RoleSubject = { role: string; canValidate?: boolean | null };
+
+/** KÔMIAN operator: provider costs, prices, credits, models, fal key, comparison, storage. */
+export function isOperator(subject: RoleSubject | null | undefined): boolean {
+  return subject?.role === 'operateur';
+}
+
+/** Client administration rights (team, media library, settings); an operator always has them. */
+export function hasAdminRights(subject: RoleSubject | null | undefined): boolean {
+  return subject?.role === 'admin' || subject?.role === 'operateur';
+}
+
+/** May approve or refuse a video: an administrator, an operator, or a collaborator holding the right. */
+export function canValidate(subject: RoleSubject | null | undefined): boolean {
+  return hasAdminRights(subject) || subject?.canValidate === true;
+}
+
+/** `requireRole('admin')` is also satisfied by an operator, who inherits every administrator right. */
+export function roleSatisfies(role: string, required: readonly string[]): boolean {
+  return required.includes(role) || (role === 'operateur' && required.includes('admin'));
+}
+
+/**
+ * A profile read before migration 0041 may still carry the former role « valideur »:
+ * it becomes a collaborator holding the right to validate, as the migration does.
+ */
+export function normalizeProfileRole(rawRole: unknown, rawCanValidate: unknown): { role: Role; canValidate: boolean } {
+  if (rawRole === 'valideur') return { role: 'collaborateur', canValidate: true };
+  const role: Role = rawRole === 'admin' || rawRole === 'operateur' ? rawRole : 'collaborateur';
+  return { role, canValidate: rawCanValidate === true };
+}
+
+/** Plain French label shown under the user's name and in the team list. */
+export function roleLabel(subject: RoleSubject): string {
+  if (subject.role === 'operateur') return 'Opérateur KÔMIAN';
+  if (subject.role === 'admin') return 'Administrateur';
+  return subject.canValidate ? 'Collaborateur · valideur' : 'Collaborateur';
+}
+
+/** Which roles an actor may assign: only an operator can create or promote an operator. */
+export function assignableRoles(actor: RoleSubject): Role[] {
+  return isOperator(actor) ? ['collaborateur', 'admin', 'operateur'] : ['collaborateur', 'admin'];
+}
